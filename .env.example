# ===== Telegram (필수) =====
# @BotFather 에서 봇 만들고 토큰 받기. 봇한테 /start 한 번 보낸 뒤
# https://api.telegram.org/bot<여기에토큰>/getUpdates 에서 chat_id 확인.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_CHAT_IDS=11111111

# ===== CDP — /refresh 모드용 (강력 추천, 사실상 필수) =====
# scripts/launch_chrome.ps1 (Win) 또는 launch_chrome.sh (Mac) 로 진짜 Chrome
# 띄우면 9222 포트 사용. 봇이 그 Chrome 에 붙어 새 코레일 anti-bot 우회.
CHROME_CDP_URL=http://127.0.0.1:9222

# ===== Anthropic (선택) =====
# /book, /coupang, 자유채팅 자연어 처리에만 사용. /refresh 만 쓸 거면 비워둠.
ANTHROPIC_API_KEY=

# ===== Korail (선택, /refresh 모드는 미사용) =====
# /refresh 모드는 사용자가 직접 Chrome 에서 로그인하므로 ID/PW 불필요.
# 옛 /book / /ktx 자동 로그인 모드를 쓸 때만 입력 (현재 새 코레일에선 막힘).
KORAIL_ID=
KORAIL_PW=

# ===== Runtime =====
HEADLESS=false
USER_DATA_DIR=./state/profile
PROXY_URL=

# ===== Models (Anthropic API 쓸 때만 의미) =====
ORCHESTRATOR_MODEL=claude-opus-4-7
ANALYZER_MODEL=claude-sonnet-4-6
