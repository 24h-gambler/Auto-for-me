# ===== Anthropic =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Telegram =====
# Create via @BotFather, get token. Then send /start to your bot and find your chat_id at:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_CHAT_IDS=11111111,22222222   # comma-separated whitelist

# ===== Korail (KTX) =====
# Used only for your own personal booking. Do NOT use for resale/scalping.
KORAIL_ID=
KORAIL_PW=
# 결제용 카드는 코레일에 미리 등록해두세요 (간편결제). 카드번호는 본 앱에 절대 저장하지 않습니다.

# ===== Runtime =====
HEADLESS=false                 # 디버깅 시 false 권장. 서버 운영은 true.
USER_DATA_DIR=./state/profile  # 브라우저 프로필 영속화 (쿠키/세션 유지)
PROXY_URL=                     # ex: http://user:pass@host:port (선택, 차단 우회용)

# CHROME_CDP_URL — 사용자 진짜 Chrome 에 붙기 (강한 anti-bot 회피, 추천).
# scripts/launch_chrome.ps1 로 Chrome 을 띄우면 자동으로 9222 포트 사용.
# 예: http://127.0.0.1:9222
CHROME_CDP_URL=

# ===== Models =====
ORCHESTRATOR_MODEL=claude-opus-4-7
ANALYZER_MODEL=claude-sonnet-4-6
